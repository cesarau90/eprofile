# ─────────────────────────────────────────────────────────────
# EProfile — variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Base de datos: PostgreSQL (Neon, Supabase, Vercel Postgres, etc.).
# En Vercel esta variable la inyecta la integración de la base de datos.
# Para desarrollo local puedes usar la misma cadena de Neon o un Postgres local.
DATABASE_URL="postgresql://usuario:password@HOST-pooler/eprofile?sslmode=require"
# Conexión DIRECTA (sin "-pooler" en el host). La usa `prisma migrate` / `db push`.
DATABASE_URL_UNPOOLED="postgresql://usuario:password@HOST/eprofile?sslmode=require"

# Secreto para firmar las sesiones (cookies). Usa una cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"

# URL pública del sitio. Se usa para construir enlaces absolutos, el QR y la vCard.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob: almacenamiento de las fotos de perfil.
# En Vercel lo inyecta la integración Blob. En local: `vercel env pull .env`
# (o pega aquí el token del store, empieza por "vercel_blob_rw_...").
BLOB_READ_WRITE_TOKEN=""

# ── Credenciales de la cuenta de administrador que crea el seed ──
SEED_ADMIN_EMAIL="admin@eprofile.test"
SEED_ADMIN_PASSWORD="Admin123!"

# ── Credenciales de los estudiantes de demostración que crea el seed ──
SEED_STUDENT1_EMAIL="juan.perez@eprofile.test"
SEED_STUDENT1_PASSWORD="Estudiante123!"
SEED_STUDENT2_EMAIL="maria.lopez@eprofile.test"
SEED_STUDENT2_PASSWORD="Estudiante123!"
